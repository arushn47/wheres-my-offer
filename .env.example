# ============================================
# NeoPAT Placement Tracker — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# --------------------------------------------
# Supabase
# --------------------------------------------
# Get these from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------
# Google OAuth 2.0
# --------------------------------------------
# Get these from: https://console.cloud.google.com → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID (Web application)
# Add authorized redirect URI: http://localhost:3000/api/auth/callback (dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --------------------------------------------
# Token Encryption
# --------------------------------------------
# Generate a 32-byte hex key for AES-256-GCM encryption of OAuth tokens
# Run this in terminal to generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# --------------------------------------------
# FastAPI Parser Service
# --------------------------------------------
# URL of the Python document parser microservice
# Local dev: http://localhost:8000
# Production: your Railway/Render deployment URL
PARSER_SERVICE_URL=
PARSER_SERVICE_API_KEY=

# --------------------------------------------
# Gemini API (Optional — AI fallback)
# --------------------------------------------
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --------------------------------------------
# Cron Authentication
# --------------------------------------------
# Secret token to secure /api/cron/sync from unauthorized requests
CRON_SECRET=

# Google Pub/Sub push authentication
# Full Pub/Sub topic resource name — setting this activates real-time Gmail push notifications.
# Format: projects/<your-gcp-project-id>/topics/<topic-name>
# Create topic at: https://console.cloud.google.com/cloudpubsub/topic/list
GOOGLE_PUBSUB_TOPIC=
# The exact HTTPS webhook URL configured as the Pub/Sub OIDC audience.
GOOGLE_PUBSUB_AUDIENCE=
# Service account email used by Pub/Sub push authentication.
GOOGLE_PUBSUB_SERVICE_ACCOUNT=

# --------------------------------------------
# App
# --------------------------------------------
NEXT_PUBLIC_APP_URL=

# --------------------------------------------
# Feedback & Support Email Alerts
# --------------------------------------------
# Target inbox to receive feedback/bug report alerts
FEEDBACK_RECIPIENT_EMAIL=
# Optional: Resend API Key for sending emails via api.resend.com (free at resend.com)
RESEND_API_KEY=
# Optional: Custom From address (e.g. "Where's My Offer <support@yourdomain.com>")
RESEND_FROM_EMAIL=
